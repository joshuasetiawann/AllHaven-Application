# AllHaven production environment (copy to .env.prod; NEVER commit the real file).
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

# Your domain (DNS A record must point at this server).
DOMAIN=yourdomain.com

# Host ports for the domain-less profile (docker-compose.prod.local.yml). Only the
# outside changes — inside Docker the containers keep 3000/8000, so nothing else
# needs reconfiguring. Changing BACKEND_PORT needs a frontend rebuild, because the
# API address is compiled into the web app.
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Local timezone used for deterministic AI answers such as current time/date.
APP_TIMEZONE=Asia/Jakarta

# --- Database ---
POSTGRES_USER=allhaven
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=allhaven

# --- Security (generate strong random values) ---
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# REQUIRED: the backend refuses to start in production with the dev default or
# a SECRET_KEY shorter than 32 characters.
SECRET_KEY=change-me-long-random
SETTINGS_ENCRYPTION_KEY=change-me-long-random-32+chars
# Decryption-only comma-separated old keys used during a key rotation.
# After setting a new current key, run from backend/:
#   python -m app.cli.rotate_secrets --dry-run && python -m app.cli.rotate_secrets
# Remove the previous keys only after the command reports a successful rotation.
SETTINGS_ENCRYPTION_KEY_PREVIOUS=
# Keep Swagger/OpenAPI hidden in production unless you are intentionally exposing it.
API_DOCS_ENABLED=false
# Blocks server-side requests from user-configured integration URLs to localhost,
# private LAN, link-local, and Tailscale 100.64.0.0/10 addresses. Enable only for
# a trusted private deployment that needs desktop-local Ollama/n8n from production.
ALLOW_PRIVATE_INTEGRATION_URLS=false

# Browser session lifetime in days (HttpOnly cookie; refresh rotates+extends).
SESSION_TTL_DAYS=7
# Per-IP POST cap per minute on /auth/* (login/register/refresh). Single-instance
# in-memory limiter; ALSO rate-limit at your gateway if you run multiple replicas.
AUTH_RATE_LIMIT_PER_MINUTE=10
# Direct reverse-proxy peers allowed to supply X-Forwarded-For. The production
# Compose stack sets its private Caddy service automatically.
AUTH_TRUSTED_PROXY_HOSTS=

# --- Supabase (optional: mobile app backend + one-way mirror of the local DB) ---
# Supabase is NOT the primary database — the Postgres container is. Configuring
# these enables: auto-provisioning a Supabase Auth user per signup, the background
# local-Postgres -> Supabase mirror, and Supabase bearer auth for the mobile app.
# Dashboard > Settings > API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard > Settings > API > JWT Secret. Required only so the mobile app (which
# logs in through Supabase) can reach Backend Bridge features. Empty = disabled.
SUPABASE_JWT_SECRET=
# PostgreSQL connection string for the Supabase project (Dashboard > Settings >
# Database > Connection string > URI, session pooler). Used to create AllHaven's
# tables in Supabase. Leave DATABASE_URL blank to keep the local container as the
# database and mirror to Supabase; set DATABASE_URL to this value instead to make
# Supabase itself the database.
SUPABASE_DB_URL=
# Background mirror interval in seconds. 0 disables the scheduler. Ignored (and
# reported as 0) when Supabase is already the primary database.
SYNC_INTERVAL_SECONDS=15
# Set ONLY when running `alembic upgrade head` against the Supabase database
# (adds RLS + policies). Never set it for the local/container Postgres. A
# DATABASE_URL pointing at Supabase implies it, so RLS is never skipped by accident.
# ALLHAVEN_DB_TARGET=supabase

# --- Optional defaults (the web Settings UI can also configure these) ---
OLLAMA_BASE_URL=

DRIVE_MAX_UPLOAD_MB=250
KNOWLEDGE_MAX_UPLOAD_MB=10
